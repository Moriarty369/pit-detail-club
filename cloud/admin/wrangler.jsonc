{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pit-detail-admin",
  "main": "../worker/app.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": { "directory": "../../dist-cloud-admin", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "PORTAL": "admin", "EMAIL_ENABLED": "false", "GOOGLE_ENABLED": "false" },
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
