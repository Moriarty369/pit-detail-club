{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pit-detail-club",
  "main": "cloud/worker/app.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "dist-cloud",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "PORTAL": "customer",
    "EMAIL_ENABLED": "false",
    "GOOGLE_ENABLED": "false",
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
}
