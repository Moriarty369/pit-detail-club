{
  "name": "pit-detail-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.cloud.json",
    "build:cloud": "vite build --config vite.cloud.config.ts",
    "test:cloud": "vitest run --config vitest.cloud.config.ts",
    "dev:cloud": "wrangler dev --port 8787",
    "deploy:cloud": "npm run build:cloud && node scripts/deploy-cloud.mjs",
    "test:cloud:e2e": "playwright test --config playwright.cloud.config.ts",
    "test:cloud:ui": "playwright test --config playwright.cloud-ui.config.ts",
    "probe:customer": "node scripts/probe-customer-deployment.mjs",
    "probe:customer:ui": "node scripts/probe-customer-browser.mjs",
    "build": "npm run build:cloud",
    "test": "npm run test:cloud",
    "verify:cloud": "npm run typecheck && npm run test:cloud && npm run build:cloud",
    "check:cloud:isolation": "node scripts/check-cloud-isolation.mjs",
    "dev": "vite --config vite.cloud.config.ts",
    "format:cloud": "prettier --write cloud tests scripts/*.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "hono": "^4.13.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^27.0.1",
    "pg": "^8.16.3",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
